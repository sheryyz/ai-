{
  "name": "morphos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MorphOS — intent-driven app generation and evolution platform",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev -w @morphos/server\" \"npm run dev -w @morphos/web\"",
    "check": "biome check . && npm run typecheck",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @morphos/web",
    "start": "npm run build && npm run start -w @morphos/server",
    "format": "biome check --write .",
    "prepare": "node -e \"try{require('node:child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
