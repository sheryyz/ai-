# MorphOS environment template
# 复制为 .env 后按需填写：  cp .env.example .env
# 不填 LLM_API_KEY 也能启动：已有应用、模板、演示样例与全部测试均可用（离线模式）。

# ── 大模型（任意 OpenAI 兼容 Chat Completions 服务）──────────────
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# deepseek-flash（快，默认）| deepseek-v4-pro（更强，较慢）
LLM_MODEL=deepseek-flash

# ── 服务 ────────────────────────────────────────────────
PORT=8787
# 相对仓库根目录
DATABASE_PATH=./data/morphos.db
# 业务时区：决定“今天”、$today 与时间显示（与服务器所在时区无关）
APP_TIMEZONE=Asia/Shanghai
