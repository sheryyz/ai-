{
  "kind": "patch",
  "intent": "门口志愿者要一个签到台，只能搜名字点签到，别让他们看到手机号",
  "summary": "新增分享页「签到台」：按姓名搜索并签到，显示签到率；禁止接触手机号",
  "baseVersion": 2,
  "operations": [
    {
      "op": "addView",
      "view": {
        "id": "desk",
        "label": "签到台",
        "audience": "门口志愿者",
        "restrictedFields": ["phone"]
      }
    },
    {
      "op": "addNode",
      "node": {
        "id": "deskPending",
        "type": "Filter",
        "view": "desk",
        "title": "未签到",
        "params": {
          "filter": {
            "field": "checkedIn",
            "operator": "eq",
            "value": false
          },
          "showChips": false
        }
      }
    },
    {
      "op": "addNode",
      "node": {
        "id": "deskAction",
        "type": "QuickAction",
        "view": "desk",
        "order": 1,
        "params": {
          "label": "签到",
          "searchFields": ["name"],
          "set": {
            "checkedIn": true
          }
        }
      }
    },
    {
      "op": "addNode",
      "node": {
        "id": "deskRate",
        "type": "Metric",
        "view": "desk",
        "order": 0,
        "params": {
          "label": "签到率",
          "aggregate": "ratio",
          "where": {
            "field": "checkedIn",
            "operator": "eq",
            "value": true
          },
          "format": "percent"
        }
      }
    },
    {
      "op": "bind",
      "binding": {
        "id": "b_dp",
        "from": {
          "node": "source",
          "port": "records"
        },
        "to": {
          "node": "deskPending",
          "port": "input"
        }
      }
    },
    {
      "op": "bind",
      "binding": {
        "id": "b_da",
        "from": {
          "node": "deskPending",
          "port": "result"
        },
        "to": {
          "node": "deskAction",
          "port": "rows"
        }
      }
    },
    {
      "op": "bind",
      "binding": {
        "id": "b_dr",
        "from": {
          "node": "source",
          "port": "records"
        },
        "to": {
          "node": "deskRate",
          "port": "rows"
        }
      }
    }
  ]
}
