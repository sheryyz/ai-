    "record-demos": "tsx src/scripts/record-demos.ts",
    "eval": "tsx src/scripts/eval.ts"
  },
  "dependencies": {
    "@morphos/shared": "0.1.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15"
  }
}
